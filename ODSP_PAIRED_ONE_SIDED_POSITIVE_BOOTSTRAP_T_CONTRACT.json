{
  "schema_version": 1,
  "contract_id": "odsp-paired-one-sided-positive-transfer-bootstrap-t-v1",
  "date": "2026-09-15",
  "purpose": "prospectively qualify directional one-sided familywise lower bootstrap-t bounds for paired shared-block validation designs",
  "alternative": "greater",
  "inference_target": "gain > declared tolerance in every predeclared group by contrast cell under a shared-block paired design",
  "method": "replicate-specific cluster ratio bootstrap-t with one signed max upper-tail pivotal statistic over the full group by contrast family and one shared block draw across all cells",
  "fixed_null_calibration_design": {
    "seed": 20260915,
    "simulations_per_scenario": 1000,
    "bootstrap_draws_per_interval": 500,
    "group_count": 6,
    "contrast_count": 2,
    "group_correlation": 0.7,
    "contrast_correlation": 0.5,
    "familywise_lower_confidence_level": 0.95
  },
  "predeclared_null_scenarios": [
    {"scenario_id": "paired-one-sided-normal-b8", "distribution": "normal", "blocks_per_group": 8},
    {"scenario_id": "paired-one-sided-normal-b20", "distribution": "normal", "blocks_per_group": 20},
    {"scenario_id": "paired-one-sided-normal-b50", "distribution": "normal", "blocks_per_group": 50},
    {"scenario_id": "paired-one-sided-t3-b20", "distribution": "student_t3", "blocks_per_group": 20}
  ],
  "acceptance_rule": {
    "metric": "one_sided_familywise_false_positive_rate",
    "nominal_alpha": 0.05,
    "maximum_accepted_rate_at_1000_simulations": 0.06378404875209022,
    "requirement": "every predeclared scenario must pass",
    "frozen_before_first_1000_simulation_result": true
  },
  "scientific_boundaries": {
    "exact_positive_mass_shared_block_support_required": true,
    "same_block_draw_shared_across_all_groups_and_contrasts": true,
    "validation_group_independence_assumed": false,
    "shared_block_exchangeability_assumed": true,
    "upstream_refit_uncertainty_included": false,
    "arbitrary_dependence_structures_validated": false,
    "power_advantage_may_be_assessed_only_after_null_qualification": true,
    "historical_empirical_endpoint_rerun": false,
    "historical_terminal_category_reclassified": false
  }
}
