{
  "schema_version": 1,
  "contract_id": "odsp-one-sided-positive-transfer-bootstrap-t-v1",
  "date": "2026-09-15",
  "purpose": "prospectively qualify one-sided familywise lower bootstrap-t bounds before using directional inference to improve transfer-ceiling power",
  "alternative": "greater",
  "inference_target": "gain > declared tolerance in every predeclared independent group",
  "method": "replicate-specific cluster ratio bootstrap-t with one max upper-tail pivotal statistic over the full group by contrast family",
  "fixed_null_calibration_design": {
    "seed": 20260915,
    "simulations_per_scenario": 1000,
    "bootstrap_draws_per_interval": 500,
    "group_count": 6,
    "contrast_correlation": 0.5,
    "familywise_lower_confidence_level": 0.95
  },
  "predeclared_null_scenarios": [
    {"scenario_id": "one-sided-c2-normal-b8", "distribution": "normal", "blocks_per_group": 8, "contrast_count": 2},
    {"scenario_id": "one-sided-c2-normal-b20", "distribution": "normal", "blocks_per_group": 20, "contrast_count": 2},
    {"scenario_id": "one-sided-c2-normal-b50", "distribution": "normal", "blocks_per_group": 50, "contrast_count": 2},
    {"scenario_id": "one-sided-c4-normal-b20", "distribution": "normal", "blocks_per_group": 20, "contrast_count": 4},
    {"scenario_id": "one-sided-c4-t3-b20", "distribution": "student_t3", "blocks_per_group": 20, "contrast_count": 4}
  ],
  "acceptance_rule": {
    "metric": "one_sided_familywise_false_positive_rate",
    "nominal_alpha": 0.05,
    "maximum_accepted_rate_at_1000_simulations": 0.06378404875209022,
    "requirement": "every predeclared scenario must pass",
    "frozen_before_first_1000_simulation_result": true
