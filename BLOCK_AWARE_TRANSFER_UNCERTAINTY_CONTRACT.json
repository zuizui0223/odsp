    "rows_within_resampled_block_kept_together": true,
    "row_independent_mode_allowed_when_blocks_omitted": true,
    "row_independent_mode_requires_independence_assumption": true,
    "percentile_interval": true
  },
  "decision_rule": {
    "robust_positive_requires_lower_bound_gt_zero": true,
    "robust_nonpositive_requires_upper_bound_le_zero": true,
    "interval_crossing_zero_is_uncertain": true,
    "too_few_blocks_is_unavailable": true,
    "robust_generalizing_requires_every_group_robust_positive": true,
    "pooled_mean_can_override_group_failure": false,
