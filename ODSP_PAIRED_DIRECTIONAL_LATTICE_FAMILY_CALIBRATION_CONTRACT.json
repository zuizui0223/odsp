{
  "schema_version": 1,
  "contract_id": "odsp-paired-directional-lattice-family-calibration-v1",
  "date": "2026-09-15",
  "purpose": "prospectively qualify paired one-sided bootstrap-t for complete information-lattice edge-family sizes corresponding to two and three information blocks",
  "family_mapping": {
    "edge_count_formula": "m * 2^(m-1)",
    "two_information_blocks": 4,
    "three_information_blocks": 12,
    "four_information_blocks": 32
  },
  "fixed_null_calibration_design": {
    "seed": 20260915,
    "simulations_per_scenario": 1000,
    "bootstrap_draws_per_interval": 500,
    "group_count": 6,
    "group_correlation": 0.7,
    "contrast_correlation": 0.5,
    "familywise_lower_confidence_level": 0.95
  },
  "predeclared_null_scenarios": [
    {"scenario_id": "paired-c4-normal-b8", "distribution": "normal", "blocks_per_group": 8, "contrast_count": 4},
    {"scenario_id": "paired-c4-normal-b20", "distribution": "normal", "blocks_per_group": 20, "contrast_count": 4},
    {"scenario_id": "paired-c4-t3-b20", "distribution": "student_t3", "blocks_per_group": 20, "contrast_count": 4},
    {"scenario_id": "paired-c12-normal-b20", "distribution": "normal", "blocks_per_group": 20, "contrast_count": 12},
    {"scenario_id": "paired-c12-normal-b50", "distribution": "normal", "blocks_per_group": 50, "contrast_count": 12},
    {"scenario_id": "paired-c12-t3-b20", "distribution": "student_t3", "blocks_per_group": 20, "contrast_count": 12}
  ],
  "acceptance_rule": {
    "metric": "one_sided_familywise_false_positive_rate",
    "nominal_alpha": 0.05,
    "maximum_accepted_rate_at_1000_simulations": 0.06378404875209022,
    "requirement": "every predeclared scenario must pass",
    "frozen_before_first_1000_simulation_result": true
  },
  "scientific_boundaries": {
    "two_information_block_complete_lattice_targeted": true,
    "three_information_block_complete_lattice_targeted": true,
    "four_or_more_information_block_complete_lattice_qualified": false,
    "exact_positive_mass_shared_block_support_required": true,
    "same_block_draw_shared_across_all_groups_and_edges": true,
    "validation_group_independence_assumed": false,
    "shared_block_exchangeability_assumed": true,
    "upstream_refit_uncertainty_included": false,
    "historical_empirical_endpoint_rerun": false,
    "historical_terminal_category_reclassified": false
  }
}
