{
  "schema_version": 1,
  "boundary_id": "n2-mee-scientific-review-distribution-v1",
  "date": "2026-09-13",
  "purpose": "make the double-anonymous MEE review archive an explicit scientific-only distribution even though the development repository contains additional governance, provenance and trust infrastructure",
  "distribution": {
    "builder": "scripts/build_n2_mee_review_bundle_v4.py",
    "role": "double_anonymous_scientific_peer_review",
    "full_development_repository_is_review_distribution": false,
    "whitelist_based": true,
    "git_history_included": false,
    "github_workflows_included": false,
    "internal_pr_or_workflow_provenance_included": false
  },
  "allowed_odsp_python_files": [
    "odsp/__init__.py",
    "odsp/added_axis_evidence.py",
    "odsp/concealed_recovery.py",
    "odsp/crossfitted_transferability.py",
    "odsp/generality_benchmark.py",
    "odsp/grouped_benchmark.py",
    "odsp/grouped_transferability.py",
    "odsp/n2_bat_preflight.py",
    "odsp/n2_bat_thickness.py",
    "odsp/niche_geometry.py",
    "odsp/projection_loss.py",
    "odsp/synthetic_benchmark.py",
    "odsp/temporal_crossfit.py",
    "odsp/temporal_information.py",
    "odsp/temporal_partition.py",
    "odsp/transferability.py",
    "odsp/vertical_information.py",
    "odsp/state_prediction.py",
    "odsp/state_prediction_benchmark.py",
    "odsp/covariate_state_prediction.py",
    "odsp/mh_antwerpen_prediction.py",
    "odsp/bop_rodent_prediction.py"
  ],
  "required_scientific_files": [
    "odsp/niche_geometry.py",
    "odsp/transferability.py",
    "odsp/temporal_partition.py",
    "odsp/state_prediction.py",
    "odsp/covariate_state_prediction.py",
    "odsp/bop_rodent_prediction.py",
    "odsp/mh_antwerpen_prediction.py",
    "review_evidence/STATE_PREDICTION_SUMMARY.json",
    "manuscript/N2_MEE_MANUSCRIPT_DRAFT_v4.md",
    "README_REVIEW.md"
  ],
  "forbidden_path_tokens": [
    ".github/",
    ".git/",
    "forecast_assessment",
    "evaluation_access",
    "evaluation_ledger",
    "checkpoint",
    "provenance_audit",
    "trust_dossier",
    "trusted_state_prediction",
    "robust_model_selection",
    "block_aware_transfer_uncertainty",
    "bounded_reweighting_robustness",
    "simultaneous_group_certification",
    "model_refit_transfer_uncertainty"
  ],
  "claim_boundary": {
    "review_distribution_is_scientific_surface": true,
    "development_repository_governance_code_is_part_of_manuscript_method": false,
    "absence_from_review_distribution_means_code_is_invalid": false,
    "review_distribution_replaces_full_reproducibility_archive_after_acceptance": false
  }
}
