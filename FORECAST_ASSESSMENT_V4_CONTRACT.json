    "base_validation_blocked_has_priority": true,
    "base_validation_unavailable_has_priority": true,
    "v2_not_certified_cannot_be_rescued_by_provenance": true,
    "v2_unavailable_cannot_be_rescued_by_provenance": true,
    "otherwise_row_mismatch_gives_v4_certification": "unavailable",
    "row_mismatch_blocking_reason": "heldout_row_mismatch",
    "successful_alignment_adds_no_new_blocking_reason": true,
    "block_definition_and_environmental_novelty_remain_warnings": true,
    "aggregate_confidence_score_emitted": false
