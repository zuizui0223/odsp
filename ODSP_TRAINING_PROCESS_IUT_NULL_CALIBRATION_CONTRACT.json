{
  "schema_version": 1,
  "contract_id": "odsp-training-process-iut-null-calibration-v2",
  "frozen_date": "2026-10-04",
  "purpose": "prospectively qualify componentwise one-sided crossed training-process bootstrap-t tests that are composed by an intersection-union rule for an all-component positive process-mean claim",
  "route_under_test": {
    "alternative": "greater",
    "validation_design": "independent_groups",
    "information_structure": "filtration",
    "contrast_count": 2,
    "upstream_refits": "predeclared_training_process",
    "external_validation": "none",
    "composition": "intersection_union_all_group_by_contrast_components"
  },
  "inferential_logic": {
    "global_alternative": "every required group x contrast process-mean gain exceeds tolerance",
    "global_null": "at least one required component process-mean gain is at or below tolerance",
    "each_component_test_level_alpha": 0.05,
    "additional_component_axis_multiplicity_correction_required": false,
    "reason": "intersection-union test: global rejection requires rejection of every component null",
    "component_lower_bounds_are_simultaneous": false,
    "individual_component_interval_reporting_as_simultaneous_forbidden": true
  },
  "generator": {
    "generator_version": "crossed_training_process_iut_component_null_c2_v2",
    "scenario_families": "same six crossed random-effects families used in frozen v1 qualification",
    "symmetry": "group labels and the two contrast labels are exchangeable in the calibration generator",
    "sentinel_component": "g00 x pooled->coarse",
    "sentinel_role": "primary component-size gate",
    "all_component_rates_retained_as_diagnostics": true
  },
  "qualification_run": {
    "seed": 20261013,
    "simulations_per_scenario": 1000,
    "bootstrap_draws_per_interval": 500,
    "cellwise_lower_confidence_level": 0.95
  },
  "acceptance_rule": {
    "metric": "sentinel_component_false_positive_rate",
    "nominal_alpha": 0.05,
    "maximum_accepted_rate_formula": "alpha + 2*sqrt(alpha*(1-alpha)/simulations_per_scenario)",
    "maximum_accepted_rate_at_1000_simulations": 0.06378404875209022,
    "every_scenario_must_pass": true,
    "maximum_component_rate_is_diagnostic_not_gate": true,
    "terminal_all_null_false_generalizing_rate_is_diagnostic_not_gate": true
  },
  "prequalification_history": {
    "v1_null_qualification_known": true,
    "v1_power_gate_failure_known": true,
    "post_v1_psd_clip_exploration_occurred": true,
    "post_v1_psd_clip_exploration_is_qualification_evidence": false,
    "small_iut_exploratory_simulations_occurred_before_this_freeze": true,
    "exploratory_iut_results_are_qualification_evidence": false,
    "iut_composition_selected_before_formal_v2_run": true,
    "formal_v2_seed_unused_before_this_freeze": true
  },
  "scope_boundary": {
