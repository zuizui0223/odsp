{
  "schema_version": 1,
  "contract_id": "odsp-independent-c12-one-sided-support-envelope-v1",
  "date": "2026-10-03",
  "purpose": "prospectively stress-test the independent-group one-sided twelve-contrast family across the same low, medium and high block-support anchors used for the four-edge route before extending the 12-edge lattice to untouched external validation",
  "alternative": "greater",
  "generator_version": "analytic_independent_group_c12_support_envelope_one_sided_v1",
  "fixed_design": {
    "seed": 20261003,
    "simulations_per_scenario": 1000,
    "bootstrap_draws_per_interval": 500,
    "group_count": 6,
    "contrast_count": 12,
    "contrast_correlation": 0.5,
    "familywise_lower_confidence_level": 0.95
  },
  "predeclared_scenarios": [
    {
      "scenario_id": "c12-support-normal-b8",
      "distribution": "normal",
      "blocks_per_group": 8
    },
    {
      "scenario_id": "c12-support-normal-b20",
      "distribution": "normal",
      "blocks_per_group": 20
    },
    {
      "scenario_id": "c12-support-normal-b50",
      "distribution": "normal",
      "blocks_per_group": 50
    },
    {
      "scenario_id": "c12-support-t3-b8",
      "distribution": "student_t3",
      "blocks_per_group": 8
    },
    {
      "scenario_id": "c12-support-t3-b20",
      "distribution": "student_t3",
      "blocks_per_group": 20
    },
    {
      "scenario_id": "c12-support-t3-b50",
      "distribution": "student_t3",
      "blocks_per_group": 50
    }
  ],
  "acceptance_rule": {
    "metric": "one_sided_familywise_false_positive_rate",
    "nominal_alpha": 0.05,
    "formula": "alpha + 2 * sqrt(alpha * (1 - alpha) / simulation_count)",
    "maximum_accepted_rate_at_1000_simulations": 0.06378404875209022,
    "requirement": "every predeclared scenario must pass",
    "frozen_before_first_1000_simulation_result": true
  },
  "qualification_if_pass": {
    "contrast_count": 12,
    "support_anchor_counts": [
      8,
      20,
      50
    ],
    "group_count_anchor": 6,
    "anchor_counts_are_exact_operating_characteristic_scenarios": true,
    "arbitrary_intermediate_or_larger_block_count_proven": false,
    "arbitrary_group_count_proven": false,
    "balanced_equal_block_count_across_groups_in_calibration": true,
    "historical_c12_result_reclassified": false
  },
  "scientific_boundaries": {
    "validation_groups_independent": true,
    "within_group_cross_contrast_covariance_preserved": true,
    "upstream_refit_uncertainty_included": false,
    "untouched_external_validation_included": false,
    "arbitrary_dependence_structures_validated": false,
    "simulation_result_is_biological_evidence": false,
    "historical_empirical_endpoint_rerun": false,
    "historical_terminal_category_reclassified": false
  }
}
