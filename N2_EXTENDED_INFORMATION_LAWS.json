    {
      "id": "conditional_entropy_chain_rule",
      "statement": "H(C,A|B) = H(C|B) + H(A|B,C)",
      "random_cases": 64
    },
    {
      "id": "effective_state_chain_rule",
      "statement": "exp(H(C,A|B)) = exp(H(C|B)) * exp(H(A|B,C))",
      "random_cases": 64
    },
    {
      "id": "expanded_base_information_monotonicity",
      "statement": "I(A;B,C) >= I(A;B)",
      "random_cases": 64
    },
    {
      "id": "deterministic_coarse_graining_data_processing",
      "statement": "Deterministically merging added-state categories cannot increase H(A|B), effective added states, or I(A;B).",
      "random_cases": 64
    },
    {
      "id": "sparse_support_same_distribution_identity",
      "statement": "E[log P(A|B)-log P(A)] = I(A;B) remains exact when the support contains structural zeros, provided the same-distribution comparison is estimable.",
      "random_cases": 128
    },
    {
      "id": "unavailable_mask_numeric_invariance",
      "statement": "Numeric contents assigned to explicitly unavailable states cannot influence H(A|B) or I(A;B).",
      "random_cases": 32
    },
    {
      "id": "uniform_joint_added_state_exactness",
